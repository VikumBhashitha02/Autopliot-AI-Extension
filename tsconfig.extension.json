{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022", "DOM"],
    "types": ["node", "vscode"],
    "typeRoots": ["./node_modules/@types"],
    "skipLibCheck": true,
    "sourceMap": true,
    "outDir": "dist-extension",
    "strict": false,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true
  },
  "include": [
    "extension/src/**/*",
    "electron/engine/**/*",
    "electron/adapters/**/*",
    "electron/security/**/*",
    "electron/storage/**/*"
  ],
  "exclude": [
    "electron/tests/**/*",
    "node_modules"
  ]
}
